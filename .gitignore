# src/main/resources/application-local.properties
# src/main/resources/application-prod.properties

# Environment files
.env
.env.local
.env.*.local

# ==============================================================
# TEST & COVERAGE
# ==============================================================
*.exec
jacoco.exec
/coverage/

# ==============================================================
# MISC
# ==============================================================
HELP.md
cookies.txt
docs-test/

# Temporary files
*.tmp
*.temp
*.bak

